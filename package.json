{
  "name": "ieee-cs-pulchowk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev": "next dev",
    "build": "bun test && next build",
    "start": "next start",
    "lint": "eslint",
    "cert:generate": "bun run scripts/generate-certificates.mjs",
    "cert:export-images": "bun run scripts/export-certificate-images.mjs",
    "cert:bbox": "test -d .venv || bun run py:setup; .venv/bin/python scripts/bbox_tool.py",
    "images:convert": "bun run scripts/convert-images.mjs",
    "images:og": "bun run scripts/generate-og-image.mjs",
    "images:thumbnails": "bun run scripts/generate-thumbnails.mjs",
    "indexnow": "bun run scripts/indexnow.mjs",
    "py:setup": "python -m venv .venv && .venv/bin/pip install -r requirements.txt"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dev": "^0.1.5",
    "framer-motion": "^12.39.0",
    "gray-matter": "^4.0.3",
    "next": "^16.2.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
